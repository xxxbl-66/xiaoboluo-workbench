{
  "name": "414-workbench",
  "version": "0.1.3",
  "description": "四一四工作台 - 本地离线个人工作台",
  "main": "electron/main.cjs",
  "author": "414-workbench",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --configLoader native",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir",
    "test": "node --test \"tests/*.test.cjs\""
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.25.12",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.xiaoboluo.workbench",
    "productName": "四一四工作台",
    "directories": {
      "output": "dist-release/v0.1.3"
    },
    "files": [
      "electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "四一四工作台",
      "artifactName": "四一四工作台_安装版.exe"
    },
    "portable": {
      "artifactName": "四一四工作台_便携版.exe"
    }
  }
}
